# ====================================================================
# LAUGH TALE (UNTOLD) - Environment Variables Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. PAYMENT GATEWAY: PHONEPE PG
# Obtain these from your PhonePe Merchant Dashboard
# (Sandbox/UAT or Production)
# --------------------------------------------------------------------
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab349842db07
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# --------------------------------------------------------------------
# 2. EMAIL SERVICE: RESEND (RECOMMENDED FOR VERCEL & NEXT.JS)
# Obtain your free API key at: https://resend.com/api-keys
# --------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Laugh Tale <tickets@yourdomain.com>

# --------------------------------------------------------------------
# 3. ALTERNATIVE EMAIL SERVICE: SMTP VIA NODEMAILER (BUSINESS EMAIL)
# If using your business email provider (Google Workspace, Zoho, etc.)
# --------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=untold@untoldentertainments.in
SMTP_PASS=your_app_specific_password_here
SMTP_FROM_NAME="LAUGH TALE by UNTOLD"

# --------------------------------------------------------------------
# 4. ORGANIZER NOTIFICATIONS
# Where you want real-time attendee notification alerts sent
# --------------------------------------------------------------------
ORGANIZER_EMAIL=untold@untoldentertainments.in
SCREENSHOT_EMAIL=adminuntold@untoldentertainments.in

# --------------------------------------------------------------------
# 5. ATTENDEE BACKUP: GOOGLE SHEETS WEBHOOK (OPTIONAL BUT RECOMMENDED)
# Google Apps Script Web App URL or Make/Zapier Webhook endpoint
# Automatically appends every confirmed booking row to your master sheet
# --------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# --------------------------------------------------------------------
# 6. APPLICATION BASE URL (e.g., https://your-domain.vercel.app)
# Used for PhonePe callbacks & email deep links
# --------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
